                            <script>
                                function loadNotifications() {
                                    fetch("get_notifications.php")
                                        .then(response => response.json())
                                        .then(data => {
                                            let html = "";
                                            if (data.length === 0) {
                                                html = `<div class="col-12"><p>No notifications yet.</p></div>`;
                                            } else {
                                                data.forEach(n => {
                                                    let cardClass = (n.status === "unread") ? "border-primary" : "border-secondary";
                                                    let messageClass = (n.status === "unread") ? "fw-bold" : "text-muted";

                                                    html += `
                                                    <div class="col-md-4 mb-3">
                                                        <div class="card ${cardClass} shadow h-100">
                                                            <div class="card-body">
                                                                <div class="notification ${n.action}">
                                                                    <strong>${n.action.toUpperCase()} in ${n.table_name}</strong><br>
                                                                    <span class="${messageClass}">${n.message}</span><br>
                                                                    <small class="text-muted"><em>${n.created_at}</em></small><br>
                                                                    ${n.status === "unread"
                                                                        ? `<button onclick="markAsRead(${n.id})" class="btn btn-sm btn-primary mt-2">Mark as Read</button>`
                                                                        : `<span class="badge bg-success mt-2">Read</span>`
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>`;
                                                });
                                            }
                                            document.getElementById("notifications").innerHTML = html;
                                        })
                                        .catch(error => console.error("Error fetching notifications:", error));
                                }

                                function markAsRead(id) {
                                    fetch("mark_as_read.php", {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/x-www-form-urlencoded"
                                            },
                                            body: "id=" + id
                                        })
                                        .then(res => res.text())
                                        .then(data => {
                                            if (data === "success") loadNotifications();
                                        });
                                }

                                // Load immediately & refresh every 5s
                                loadNotifications();
                                setInterval(loadNotifications, 5000);
                            </script>


                      
