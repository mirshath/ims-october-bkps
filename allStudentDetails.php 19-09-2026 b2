    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            let dataTable = null;

            // ---------------------------------------------------------------
            // Advanced Column Filter setup
            // ---------------------------------------------------------------
            // Must match the <th> order in the table exactly (index 0 - 17)
            const columnLabels = [
                'BMS Registration ID (AG)', 'Program Registration ID', 'Student Code (System)',
                'NIC', 'Title', 'Full Name', 'Name to be appeared', 'DOB', 'Nationality',
                'Permanent Address', 'Current Address', 'Mobile', 'Telephone',
                'Personal Email', 'BMS Email', 'Occupation', 'Status', 'Entered By'
            ];

            // Columns visible by default (indexes into columnLabels)
            const defaultVisible = [0, 1, 4, 5, 13, 14, 17];

            const $colMenu = $('#columnFilterMenu');
            const $colList = $('#colFilterList');
            const $colBtn = $('#columnFilterBtn');
            const $colCount = $('#colFilterCount');
            const $colSubtitle = $('#colFilterSubtitle');

            // Build one checkbox row per column
            columnLabels.forEach((label, idx) => {
                const checked = defaultVisible.includes(idx) ? 'checked' : '';
                $colList.append(`
                    <li class="col-filter-item">
                        <input type="checkbox" class="column-toggle"
                               data-col="${idx}" id="col-chk-${idx}" ${checked}>
                        <label for="col-chk-${idx}">${label}</label>
                    </li>
                `);
            });

            // Clicking anywhere on a row (not just the tiny checkbox) toggles it
            $colList.on('click', '.col-filter-item', function(e) {
                if ($(e.target).is('input, label')) return; // let native behavior handle these
                $(this).find('.column-toggle').trigger('click');
            });

            // Keep the "X of 18 selected" text + badge in sync
            function updateColFilterCount() {
                const checkedCount = $('.column-toggle:checked').length;
                $colCount.text(checkedCount);
                $colSubtitle.text(checkedCount + ' of ' + columnLabels.length + ' selected');
            }
            updateColFilterCount();

            // Keep dropdown open while interacting inside the panel
            $colMenu.on('click', function(e) {
                e.stopPropagation();
            });

            // Manual dropdown open/close (no Bootstrap JS dependency)
            function openColFilter() {
                $colMenu.show();
                $colBtn.addClass('active');
            }

            function closeColFilter() {
                $colMenu.hide();
                $colBtn.removeClass('active');
            }

            $colBtn.on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if ($colMenu.is(':visible')) {
                    closeColFilter();
                } else {
                    openColFilter();
                }
            });

            $('#colFilterClose').on('click', function(e) {
                e.preventDefault();
                closeColFilter();
            });

            // Close the dropdown when clicking anywhere outside it
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#columnFilterWrapper').length) {
                    closeColFilter();
                }
            });

            // Live-toggle visibility if the table has already been rendered
            $colList.on('change', '.column-toggle', function() {
                const colIdx = $(this).data('col');
                const isChecked = $(this).is(':checked');
                updateColFilterCount();
                if (dataTable) {
                    // false = don't redraw yet, we'll do a full adjust + responsive recalc below
                    dataTable.column(colIdx).visible(isChecked, false);
                    dataTable.columns.adjust();
                    if (dataTable.responsive && typeof dataTable.responsive.recalc === 'function') {
                        dataTable.responsive.recalc();
                    }
                    dataTable.draw(false);
                }
            });

            // Applies a set of checked states in one batch, then redraws once
            function applyColumnCheckedStates(shouldBeChecked) {
                // shouldBeChecked: function(colIdx) => bool
                $('.column-toggle').each(function() {
                    const idx = $(this).data('col');
                    const checked = shouldBeChecked(idx);
                    $(this).prop('checked', checked);
                    if (dataTable) {
                        dataTable.column(idx).visible(checked, false);
                    }
                });
                updateColFilterCount();
                if (dataTable) {
                    dataTable.columns.adjust();
                    if (dataTable.responsive && typeof dataTable.responsive.recalc === 'function') {
                        dataTable.responsive.recalc();
                    }
                    dataTable.draw(false);
                }
            }

            // Select All
            $('#colSelectAll').on('click', function(e) {
                e.preventDefault();
                applyColumnCheckedStates(() => true);
            });

            // Reset to Default
            $('#colResetDefault').on('click', function(e) {
                e.preventDefault();
                applyColumnCheckedStates(idx => defaultVisible.includes(idx));
            });
            // ---------------------------------------------------------------

            // Initialize Select2
            $('.select2').select2();

            // Directly load all programs
            $.ajax({
                url: 'Batch_transer/fetch_programs_without_uni.php',
                type: 'POST',
                success: function(data) {
                    $('#programDropdown').html(data).trigger('change');
                }
            });


            // Fetch batches based on selected program
            $('#programDropdown').on('change', function() {
                const programId = $(this).val();
                if (programId) {
                    $.ajax({
                        url: 'reports/AllStudents/fetch_batches.php',
                        type: 'POST',
                        data: {
                            program_id: programId
                        },
                        success: function(data) {
                            $('#batchDropdown').html(data).trigger('change');
                        }
                    });
                } else {
                    $('#batchDropdown').html('<option value="">Select Batch</option>').trigger('change');
                }
            });

            // Submit Button Click Handler
            $('#submitBtn').on('click', function() {
                const $btn = $(this);
                const filters = {
                    // university_id: 1, 
                    program_id: $('#programDropdown').val(),
                    batch_id: $('#batchDropdown').val(),
                    status: $('#statusDropdown').val()
                };

                // Check if program is selected
                if (!filters.program_id) {
                    alert('Please select a program');
                    return;
                }

                // Disable button to prevent double-click (no text change)
                $btn.prop('disabled', true);

                // Destroy existing DataTable if it exists
                if ($.fn.DataTable.isDataTable('#studentsDataTable')) {
                    $('#studentsDataTable').DataTable().destroy();
                }

                // Show loading indicator in table
                $('#resultsBody').html('<tr><td colspan="17" class="text-center">Loading...</td></tr>');
                $('#resultsSection').show();

                // Fetch filtered results
                $.ajax({
                    url: 'reports/AllStudents/fetch_student_details.php',
                    type: 'POST',
                    data: filters,
                    success: function(response) {
                        $('#resultsBody').html(response);

                        // Only initialize DataTable if data is found
                        if (response.indexOf('No results found') === -1) {
                            // Determine which columns should start hidden based on current checkbox state
                            const hiddenColumns = columnLabels
                                .map((_, idx) => idx)
                                .filter(idx => !$(`#col-chk-${idx}`).is(':checked'));

                            dataTable = $('#studentsDataTable').DataTable({
                                pageLength: 100,
                                dom: 'Bfrtip',
                                columnDefs: [{
                                    targets: hiddenColumns,
                                    visible: false
                                }],
                                buttons: [{
                                        extend: 'copy',
                                        className: 'btn btn-primary btn-sm'
                                    },
                                    {
                                        extend: 'csv',
                                        className: 'btn btn-primary btn-sm'
                                    },
                                    {
                                        extend: 'excel',
                                        className: 'btn btn-primary btn-sm'
                                    },
                                    {
                                        extend: 'pdf',
                                        className: 'btn btn-primary btn-sm',
                                        orientation: 'landscape',
                                        pageSize: 'A4',
                                        title: 'Student Details',
                                        customize: function(doc) {
                                            doc.pageMargins = [20, 20, 20, 20];
                                        }
                                    },
                                    {
                                        extend: 'print',
                                        className: 'btn btn-primary btn-sm',
                                        orientation: 'landscape',
                                        pageSize: 'A4',
                                        title: 'Student Details',
                                        customize: function(win) {
                                            $(win.document.body)
                                                .css('font-size', '12px')
                                                .find('h1')
                                                .css('text-align', 'center');
                                        }
                                    }
                                ],
                                responsive: true,
                                ordering: true,
                                searching: true,
                                info: true,
                                lengthChange: true,
                                language: {
                                    search: "_INPUT_",
                                    searchPlaceholder: "Search records..."
                                }
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        $('#resultsBody').html('<tr><td colspan="17" class="text-center text-danger">Error loading data: ' + error + '</td></tr>');
                    },
                    complete: function() {
                        // Re-enable button
                        $btn.prop('disabled', false).html('Submit');
                    }
                });
            });

            // Add error handling for empty or invalid responses
            $(document).ajaxError(function(event, jqxhr, settings, thrownError) {
                console.error('Ajax error:', thrownError);
            });

            // Add custom styling for DataTables buttons and search
            $('<style>')
                .prop('type', 'text/css')
                .html(`
                    .dt-buttons .btn {
                        margin-right: 5px;
                        margin-bottom: 5px;
                    }
                    .dataTables_filter {
                        margin-bottom: 10px;
                    }
                    .dataTables_filter input {
                        width: 300px;
                        padding: 5px 10px;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                    }
                `)
                .appendTo('head');
        });
    </script>

