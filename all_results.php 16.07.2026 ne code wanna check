                                        // Custom Modal Class
                                        class CustomModal {
                                            constructor(element) {
                                                this.element = element;
                                                this.isShown = false;
                                                this.bindEvents();
                                            }

                                            bindEvents() {
                                                const closeButtons = this.element.querySelectorAll('[data-dismiss="modal"], .custom-close');
                                                closeButtons.forEach(button => {
                                                    button.addEventListener('click', (e) => {
                                                        e.preventDefault();
                                                        this.hide();
                                                    });
                                                });

                                                const modalContent = this.element.querySelector('.custom-modal-content');
                                                if (modalContent) {
                                                    modalContent.addEventListener('click', (e) => {
                                                        e.stopPropagation();
                                                    });
                                                }

                                                this.element.addEventListener('click', (e) => {
                                                    if (e.target === this.element) {
                                                        const isStatic = this.element.getAttribute('data-backdrop') === 'static';
                                                        if (!isStatic) {
                                                            this.hide();
                                                        }
                                                    }
                                                });
                                            }

                                            show() {
                                                if (this.isShown) return;
                                                this.isShown = true;
                                                document.body.style.overflow = 'hidden';
                                                this.element.style.display = 'block';
                                                this.element.classList.add('show');
                                                this.element.setAttribute('aria-hidden', 'false');
                                                this.element.focus();
                                            }

                                            hide() {
                                                if (!this.isShown) return;
                                                this.isShown = false;
                                                document.body.style.overflow = '';
                                                this.element.classList.remove('show');
                                                setTimeout(() => {
                                                    this.element.style.display = 'none';
                                                    this.element.setAttribute('aria-hidden', 'true');
                                                }, 150);
                                            }
