function getHDGradeFromMarks($finalMark)
{
    // If mark is negative, treat as "Not Submitted"
    if ($finalMark < 0) {
        return 'Not Submitted';
    }
    if ($finalMark == 0) {
        return 'Absent';
    }

    // 2.6 rule: promote borderline marks
    if ($finalMark == 49)
        $finalMark = 50;
    if ($finalMark == 59)
        $finalMark = 60;
    if ($finalMark == 69)
        $finalMark = 70;

    if ($finalMark <= 29)
        return 'Re-sit';       // 0-29
    elseif ($finalMark <= 49)
        return 'Pending';  // 30-49
    elseif ($finalMark <= 59)
        return 'Pass';     // 50-59
    elseif ($finalMark <= 69)
        return 'Merit';    // 60-69
    elseif ($finalMark <= 100)
        return 'Distinction'; // 70-100

    return 'Unknown';
}


