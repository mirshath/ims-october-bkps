    $filteredResultsSend = [];
    $moduleName = $details['module_name'];
    while ($row = $result->fetch_assoc()) {
        $compulsory_subs = explode(',', $row['compulsory_sub']);
        $elective_subs_array = explode(',', $row['elective_subs']);
        $compulsory_subs = array_map('trim', $compulsory_subs);
        $elective_subs_array = array_map('trim', $elective_subs_array);
        if (in_array($moduleName, $compulsory_subs) || in_array($moduleName, $elective_subs_array)) {
            $filteredResultsSend[] = $row;
