    <script>
        (function() {
            var form = document.getElementById('loginForm');
            var btn = document.getElementById('submitBtn');
            var label = btn.querySelector('.label');
            var pwd = document.getElementById('password');
            var user = document.getElementById('username');
            var toggle = document.getElementById('togglePassword');
            var eyeOn = document.getElementById('eyeOn');
            var eyeOff = document.getElementById('eyeOff');
            var caps = document.getElementById('capsWarn');

            // Show / hide password
            toggle.addEventListener('click', function() {
                var show = pwd.type === 'password';
                pwd.type = show ? 'text' : 'password';
                eyeOn.style.display = show ? 'none' : '';
                eyeOff.style.display = show ? '' : 'none';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                pwd.focus();
            });

            // Caps Lock hint
            function checkCaps(e) {
                if (e.getModifierState) {
                    caps.classList.toggle('on', e.getModifierState('CapsLock'));
                }
            }
            pwd.addEventListener('keydown', checkCaps);
            pwd.addEventListener('keyup', checkCaps);
            pwd.addEventListener('blur', function() {
                caps.classList.remove('on');
            });

            // Loading state on submit (hidden input carries the "login" flag)
            form.addEventListener('submit', function(e) {
                if (!user.value.trim() || !pwd.value) {
                    e.preventDefault();
                    (user.value.trim() ? pwd : user).focus();
                    return;
                }
                if (btn.classList.contains('is-loading')) {
                    e.preventDefault();
                    return;
                }
                btn.classList.add('is-loading');
                btn.setAttribute('aria-busy', 'true');
                label.textContent = 'Signing in…';
            });

            // Reset button if the user returns via back/forward cache
            window.addEventListener('pageshow', function(e) {
                if (e.persisted) {
                    btn.classList.remove('is-loading');
                    btn.removeAttribute('aria-busy');
                    label.textContent = 'Sign in';
                }
            });
        })();
    </script>
