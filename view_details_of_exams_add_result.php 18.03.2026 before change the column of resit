<script>
    // Store the main component percentage value from PHP to JavaScript
    const mainComponentPercentValue = <?php echo json_encode($mainComponentPercentValue); ?>;
    console.log("Main Component Percentage Value:", mainComponentPercentValue);

    // ------------------------------------------------------------------------------------- 
    // ------------------------------------------------------------------------------------- 
    // HD Grade finder 
    // ------------------------------------------------------------------------------------- 
    // ------------------------------------------------------------------------------------- 
    // Function to determine the grade based on divided mark
    function getGrade(dividedMark) {
        let grade = '';
        switch (mainComponentPercentValue) {
            case 20:
                if (dividedMark < 0) grade = 'Absent';
                else if (dividedMark <= 5) grade = 'Re-sit';
                else if (dividedMark <= 9) grade = 'Pending';
                else if (dividedMark <= 11) grade = 'Pass';
                else if (dividedMark <= 13) grade = 'Merit';
                else if (dividedMark <= 20) grade = 'Distinction';
                break;
            case 25:
                if (dividedMark <= 0) grade = 'Absent';
                else if (dividedMark <= 7) grade = 'Re-sit';
                else if (dividedMark <= 12) grade = 'Pending';
                else if (dividedMark <= 14) grade = 'Pass';
                else if (dividedMark <= 17) grade = 'Merit';
                else if (dividedMark <= 25) grade = 'Distinction';
                break;
            case 40:
                if (dividedMark < 0) grade = 'Absent';
                else if (dividedMark <= 11) grade = 'Re-sit';
                else if (dividedMark <= 19) grade = 'Pending';
                else if (dividedMark <= 23) grade = 'Pass';
                else if (dividedMark <= 27) grade = 'Merit';
                else if (dividedMark <= 40) grade = 'Distinction';
                break;
            case 50:
                if (dividedMark < 0) grade = 'Absent';
                else if (dividedMark <= 14) grade = 'Re-sit'; // 0- 14
                else if (dividedMark <= 24) grade = 'Pending'; // 15 - 24 
                else if (dividedMark <= 29) grade = 'Pass'; // 25 - 29
                else if (dividedMark <= 34) grade = 'Merit'; // 30 - 34
                else if (dividedMark <= 50) grade = 'Distinction'; // 35 - 50
                break;
            case 60:
                if (dividedMark < 0) grade = 'Absent';
                else if (dividedMark <= 17) grade = 'Re-sit';
                else if (dividedMark <= 29) grade = 'Pending';
                else if (dividedMark <= 35) grade = 'Pass';
                else if (dividedMark <= 41) grade = 'Merit';
                else if (dividedMark <= 60) grade = 'Distinction';
                break;
            case 80:
                if (dividedMark < 0) grade = 'Absent';
                else if (dividedMark <= 23) grade = 'Re-sit';
                else if (dividedMark <= 39) grade = 'Pending';
                else if (dividedMark <= 47) grade = 'Pass';
                else if (dividedMark <= 55) grade = 'Merit';
                else if (dividedMark <= 80) grade = 'Distinction';
                break;
            case 100:
                if (dividedMark < 0) grade = 'Absent'; // 0 - Absent
                else if (dividedMark <= 29) grade = 'Re-sit'; // 1 - 29
                else if (dividedMark <= 49) grade = 'Pending'; // 30 - 49
                else if (dividedMark <= 59) grade = 'Pass'; // 50 - 59      
                else if (dividedMark <= 69) grade = 'Merit'; // 60 - 69
                else if (dividedMark <= 100) grade = 'Distinction'; // 70 - 100 
                break;
            default:
                grade = 'Unknown';
        }
        return grade;
    }

    function calculateDividedMarkAndGrade(input) {
        const row = input.closest('tr');
        if (input.id && input.id.indexOf('fullMarks_') === 0) {
