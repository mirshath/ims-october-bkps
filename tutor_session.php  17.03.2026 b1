<script>
const batches = <?php echo json_encode($batch_list); ?>;

// Load batches when program changes
$('#program').change(function() {
    const program = $(this).val();
    const batchDropdown = $('#batch');

    batchDropdown.html('<option value="">-- Select Batch --</option>');

    if(program && batches[program]) {
        batches[program].forEach(batch => {
            batchDropdown.append(`<option value="${batch.batch_id}">${batch.batch_name}</option>`);
        });
    }

    $('#sessionTable tbody').html(''); // Clear sessions until batch selected
});

// Load sessions when tutor or batch changes
$('#tutor, #batch').change(function() {
    const program = $('#program').val();
    const tutor   = $('#tutor').val();
    const batch   = $('#batch').val();

    if(!program || !tutor || !batch) {
        $('#sessionTable tbody').html('');
        return;
    }

    $.post('tutor_session.php', {
        action: 'get_sessions',
        program_code: program,
        tutor_id: tutor,
        batch_id: batch
    }, function(data) {
        let html = '';
        data.forEach(row => {
            const checked = row.allocated == 1 ? 'checked' : '';
            const showDate = row.allocated == 1 ? '' : 'd-none';
            html += `
            <tr>
                <td>${row.session_name}</td>
                <td>${row.session_type}</td>
                <td class="text-center">
                    <input type="checkbox"
                           class="form-check-input allocateSwitch"
                           data-id="${row.session_id}"
                           name="allocated[]"
                           value="${row.session_id}"
                           ${checked}>
                </td>
                <td>
                    <input type="date"
                           class="form-control start-date ${showDate}"
                           name="start_date[${row.session_id}]"
                           value="${row.session_start_date ?? ''}">
                </td>
                <td>
                    <input type="date"
                           class="form-control end-date ${showDate}"
                           name="end_date[${row.session_id}]"
                           value="${row.session_end_date ?? ''}">
                </td>
            </tr>`;
        });
        $('#sessionTable tbody').html(html);
    }, 'json');
});

// Toggle date inputs when allocation switch changes
$(document).on('change', '.allocateSwitch', function () {
    const row = $(this).closest('tr');
    row.find('.start-date, .end-date')
       .toggleClass('d-none', !this.checked);
});
</script>

