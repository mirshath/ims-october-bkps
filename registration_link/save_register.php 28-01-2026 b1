                'year' => $ol_year,
                'school' => $ol_school
            ];
        }
    }
}

$al_results = [];
if (!empty($al_subjects) && is_array($al_subjects)) {
    for ($i = 0; $i < count($al_subjects); $i++) {
        $subject = isset($al_subjects[$i]) ? trim($al_subjects[$i]) : null;
        $grade = isset($al_grades[$i]) ? trim($al_grades[$i]) : null;
        if ($subject && $grade) {
            $al_results[] = [
                'subject' => $subject,
                'grade' => $grade,
                'year' => $al_year,
