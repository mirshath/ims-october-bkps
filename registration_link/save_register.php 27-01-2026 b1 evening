// Utility: Generate Temporary ID
function generateTempID($nic, $passport)
{
    if (!empty($nic)) {
        return 'BMS' . strtoupper($nic);
    } elseif (!empty($passport)) {
        return 'BMS' . strtoupper($passport);
    } else {
        return 'BMS' . bin2hex(random_bytes(4));
    }
}

