        'email' => $email,
        'program' => $program,
        'batch' => $batch,
        'created_at' => $created_at,
        'ol_results' => $ol_results,
        'al_results' => $al_results,
        'academic_qualifications' => $academic_results,
        'other_qualifications' => $other_qual_results,
        'qr_image_path' => ($qrFile && file_exists($qrFile)) ? realpath($qrFile) : null, // Pass path to QR if generated
    ];

    // Define the output PDF path
    // Store in same folder as QR: qr/Program-Batch/
    $folderName = $program . "-" . $batch;
    // Sanitize folder name slightly to be safe (though program/batch should be clean enough from previous logic)
    // Use __DIR__ because we are in registration_link/ and want to write to registration_link/qr/...
    $pdfOutputFolder = __DIR__ . '/qr/' . $folderName;

    if (!is_dir($pdfOutputFolder)) {
        if (!mkdir($pdfOutputFolder, 0777, true)) {
            // If mkdir fails, fallback to temp dir to avoid crash, or just log
            error_log("Failed to create dir: $pdfOutputFolder");
        }
    }

    // Filename: BMS + NIC (temp_id is essentially BMS+NIC)
    // User requested "BMS+their NIC" -> temp_id format matches this (e.g. BMS12345V)
    $pdfFile = $pdfOutputFolder . '/' . $temp_id . '.pdf';

    $pdfData['output_pdf_path'] = $pdfFile; // Tell Python where to save the PDF

    // 3. Save JSON for Python
    $jsonPath = sys_get_temp_dir() . '/reg_pdf_' . $temp_id . '_' . time() . '.json';
    file_put_contents($jsonPath, json_encode($pdfData));

    // 4. Run Python Script (The NEW one: After_submit_student_data.py)
    $scriptPath = dirname(__DIR__) . '/After_submit_student_data.py';

    // Use quotes for paths to be safe
    $cmd = 'python "' . $scriptPath . '" "' . $jsonPath . '" 2>&1';

    $output = shell_exec($cmd);

    // Debug Logging (Optional)
    // file_put_contents(__DIR__ . '/debug_pdf_gen.txt', "CMD: $cmd\nOUTPUT: $output\n", FILE_APPEND);

    if (file_exists($jsonPath))
        unlink($jsonPath);

    if (!file_exists($pdfFile)) {
        error_log("PDF Gen Failed: " . $output);
        $pdfFile = "";
    }
} catch (Exception $e) {
    error_log("PDF Gen Exception: " . $e->getMessage());
    $pdfFile = "";
}

