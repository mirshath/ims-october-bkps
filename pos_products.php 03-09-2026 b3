/**
 * Handles an uploaded product image. Returns [$imagePath, $error].
 * - If no file was chosen, returns the existing path unchanged (no error) —
 *   this lets "update" keep the current image when the admin doesn't pick a new one.
 * - Validates type (jpg/png/webp/gif) and size (max 5MB) before saving.
 * - Saves into pos-product-image/ with a unique filename to avoid collisions.
 */
function handle_product_image_upload($fileKey, $existing = '')
{
  if (!isset($_FILES[$fileKey]) || $_FILES[$fileKey]['error'] === UPLOAD_ERR_NO_FILE) {
    return [$existing, null];
  }
  if ($_FILES[$fileKey]['error'] !== UPLOAD_ERR_OK) {
    return [$existing, 'Image upload failed. Please try again.'];
  }

  $tmpPath = $_FILES[$fileKey]['tmp_name'];
  $size = $_FILES[$fileKey]['size'];
  if ($size > 5 * 1024 * 1024) {
    return [$existing, 'Image must be smaller than 5MB.'];
  }

  $allowed = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp', 'image/gif' => 'gif'];
  $mime = function_exists('mime_content_type') ? mime_content_type($tmpPath) : $_FILES[$fileKey]['type'];
  if (!isset($allowed[$mime])) {
    return [$existing, 'Only JPG, PNG, WEBP or GIF images are allowed.'];
  }

  $dir = __DIR__ . '/pos-product-image/';
  if (!is_dir($dir) && !mkdir($dir, 0755, true)) {
    return [$existing, 'Could not create upload folder on the server.'];
  }

  $filename = 'prod_' . date('Ymd_His') . '_' . bin2hex(random_bytes(4)) . '.' . $allowed[$mime];
  $dest = $dir . $filename;
  if (!move_uploaded_file($tmpPath, $dest)) {
    return [$existing, 'Failed to save the uploaded image.'];
  }

  return ['pos-product-image/' . $filename, null];
}

if ($conn && $_SERVER['REQUEST_METHOD'] === 'POST') {
  $token = isset($_POST['csrf_token']) ? $_POST['csrf_token'] : '';
  if (!csrf_verify($token)) {
    $msg = 'Invalid request';
    $msg_class = 'danger';
  } else {
    $action = isset($_POST['action']) ? $_POST['action'] : '';

    if ($action === 'add') {
      $id = trim($_POST['id']);
      $name = trim($_POST['name']);
      $price = is_numeric($_POST['price']) ? floatval($_POST['price']) : null;
      $stock = is_numeric($_POST['stock']) ? intval($_POST['stock']) : null;
      $store_stock = (isset($_POST['store_stock']) && $_POST['store_stock'] !== '' && is_numeric($_POST['store_stock']))
        ? intval($_POST['store_stock']) : null;
      $active = isset($_POST['active']) ? 1 : 0;
      list($image, $uploadError) = handle_product_image_upload('image_file', '');
      if ($uploadError) {
        $msg = $uploadError;
        $msg_class = 'danger';
      } elseif ($id !== '' && $name !== '' && $price !== null && $stock !== null && $price >= 0 && $stock >= 0 && ($store_stock === null || $store_stock >= 0)) {
        $st = mysqli_prepare($conn, "INSERT INTO products(id,name,price,store_stock,stock,image,active) VALUES(?,?,?,?,?,?,?)");
        mysqli_stmt_bind_param($st, 'ssdiisi', $id, $name, $price, $store_stock, $stock, $image, $active);
        $exec = mysqli_stmt_execute($st);
        $errno = mysqli_errno($conn);
        $ok = $exec && mysqli_stmt_affected_rows($st) > 0;
        mysqli_stmt_close($st);
        if ($ok) {
          $msg = 'Product added';
          $msg_class = 'success';
        } else {
          $msg = ($errno === 1062) ? 'Product ID already exists' : 'Failed to add';
          $msg_class = 'danger';
        }
      } else {
        $msg = 'Please provide valid ID, name, price and stock';
        $msg_class = 'warning';
      }
    } elseif ($action === 'update') {
      $id = trim($_POST['id']);
      $name = trim($_POST['name']);
      $price = is_numeric($_POST['price']) ? floatval($_POST['price']) : null;
      $stock = is_numeric($_POST['stock']) ? intval($_POST['stock']) : null;
      $store_stock = (isset($_POST['store_stock']) && $_POST['store_stock'] !== '' && is_numeric($_POST['store_stock']))
        ? intval($_POST['store_stock']) : null;
      $existingImage = isset($_POST['current_image']) ? trim($_POST['current_image']) : '';
      list($image, $uploadError) = handle_product_image_upload('image_file', $existingImage);
      if ($uploadError) {
        $msg = $uploadError;
        $msg_class = 'danger';
      } elseif ($id !== '' && $name !== '' && $price !== null && $stock !== null && $price >= 0 && $stock >= 0 && ($store_stock === null || $store_stock >= 0)) {
        $st = mysqli_prepare($conn, "UPDATE products SET name=?, price=?, store_stock=?, stock=?, image=? WHERE id=?");
        mysqli_stmt_bind_param($st, 'sdiiss', $name, $price, $store_stock, $stock, $image, $id);
        $exec = mysqli_stmt_execute($st);
        $ok = $exec && mysqli_stmt_affected_rows($st) >= 0;
        mysqli_stmt_close($st);
        if ($ok) {
          $msg = 'Product updated';
          $msg_class = 'success';
        } else {
          $msg = 'Failed to update';
          $msg_class = 'danger';
        }
      } else {
        $msg = 'Please provide valid name, price and stock';
        $msg_class = 'warning';
      }
    } elseif ($action === 'toggle_status') {
      $id = trim($_POST['id']);
      $active = isset($_POST['active']) && $_POST['active'] === '1' ? 1 : 0;
      if ($id !== '') {
        $st = mysqli_prepare($conn, "UPDATE products SET active=? WHERE id=?");
        mysqli_stmt_bind_param($st, 'is', $active, $id);
        $exec = mysqli_stmt_execute($st);
        mysqli_stmt_close($st);
        if ($exec) {
          $msg = $active ? 'Product activated - now visible in the store' : 'Product deactivated - hidden from the store';
          $msg_class = $active ? 'success' : 'secondary';
        } else {
          $msg = 'Failed to update status';
          $msg_class = 'danger';
        }
      }
    } elseif ($action === 'delete') {
      $id = trim($_POST['id']);
      if ($id !== '') {
        $st = mysqli_prepare($conn, "DELETE FROM products WHERE id=?");
        mysqli_stmt_bind_param($st, 's', $id);
        $exec = mysqli_stmt_execute($st);
        $errno = mysqli_errno($conn);
        $ok = $exec && mysqli_stmt_affected_rows($st) > 0;
        mysqli_stmt_close($st);
        if ($ok) {
          $msg = 'Product deleted';
          $msg_class = 'success';
        } else {
          if ($errno === 1451) {
            $msg = 'Cannot delete: product is referenced by orders';
          } else {
            $msg = 'Failed to delete';
          }
          $msg_class = 'danger';
        }
      }
    }
  }
}

