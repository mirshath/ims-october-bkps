<script>
  function posPreviewImage(input, imgId) {
    if (!input.files || !input.files[0]) return;
    var img = document.getElementById(imgId);
    if (!img) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      img.src = e.target.result;
      img.style.visibility = 'visible';
    };
    reader.readAsDataURL(input.files[0]);
  }
</script>
<script>
  (function() {
    var input = document.getElementById('productSearch');
    if (!input) return;
    input.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      document.querySelectorAll('#productTable tbody tr[data-search], #productCards > [data-search]').forEach(function(el) {
        el.style.display = el.getAttribute('data-search').indexOf(q) > -1 ? '' : 'none';
      });
    });
  })();
</script>

