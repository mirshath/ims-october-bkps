<?php
session_start();
include '../database/connection.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $studentId = $_POST['student_id'] ?? '';
    $programmeBatch = $_POST['programme_batch'] ?? '';
    $percentage = $_POST['percentage'] ?? '';

    if (!empty($studentId) && !empty($programmeBatch) && is_numeric($percentage)) {
        // $stmt = $conn->prepare("UPDATE installment_payment_table SET discounted_percentage = ? WHERE student_id = ? AND programme_batch = ?");
        $stmt = $conn->prepare("UPDATE installment_payment_table SET discounted_percentage = ?, dis_yes_no = 1 WHERE student_id = ? AND programme_batch = ?");
        $stmt->bind_param("dss", $percentage, $studentId, $programmeBatch);
        if ($stmt->execute()) {
            echo json_encode(['success' => true]);
        } else {
            echo json_encode(['success' => false, 'message' => 'Database update failed']);
        }



        $stmt->close();
    } else {
        echo json_encode(['success' => false, 'message' => 'Invalid input']);
    }
} else {
    echo json_encode(['success' => false, 'message' => 'Invalid request']);
}
