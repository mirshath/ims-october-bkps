<?php
include '../database/connection.php';

$response = [
    'success' => false,
    'student_reg_ids' => [],
    'new_student_reg_ids' => [],
    'last_entered_id' => null,
    'last_new_entered_id' => null
];

if (isset($_POST['program_code'], $_POST['batch_id'])) {
    $program_code = $_POST['program_code'];
    $batch_id = $_POST['batch_id'];
    $year_prefix = isset($_POST['year_prefix']) ? $_POST['year_prefix'] : null;

    // Query for student_registration_id with filters
    $query1 = "SELECT student_registration_id 
               FROM allocate_programme 
               WHERE programme_code = ? 
                 AND batch_id = ? 
                 AND student_registration_id IS NOT NULL 
                 AND student_registration_id != '' 
               ORDER BY id DESC";

    $stmt1 = $conn->prepare($query1);
    $stmt1->bind_param("si", $program_code, $batch_id);
    $stmt1->execute();
    $result1 = $stmt1->get_result();

    $reg_ids = [];
    while ($row = $result1->fetch_assoc()) {
        $reg_ids[] = $row['student_registration_id'];
    }

    // Query for new_student_registration_id filtered by year_prefix if provided
    if ($year_prefix !== null) {
        $query2 = "SELECT new_student_registration_id 
                   FROM allocate_programme 
                   WHERE new_student_registration_id IS NOT NULL 
                     AND new_student_registration_id != '' 
                     AND new_student_registration_id LIKE CONCAT(?, '%')
                   ORDER BY id DESC";

        $stmt2 = $conn->prepare($query2);
        $stmt2->bind_param("s", $year_prefix);
        $stmt2->execute();
        $result2 = $stmt2->get_result();

        $new_reg_ids = [];
        $matched_new_id = null;

        while ($row = $result2->fetch_assoc()) {
            $id = $row['new_student_registration_id'];
            $new_reg_ids[] = $id;

            if ($matched_new_id === null) {
                $matched_new_id = $id; // The most recent matching ID
            }
        }

        // If no IDs found with prefix, DO NOT fallback; keep empty/null
        if (empty($new_reg_ids)) {
            $matched_new_id = null;
            $new_reg_ids = [];
        }
    } else {
        // If no year_prefix provided, get all new_student_registration_id
        $query2 = "SELECT new_student_registration_id 
                   FROM allocate_programme 
                   WHERE new_student_registration_id IS NOT NULL 
                     AND new_student_registration_id != '' 
                   ORDER BY id DESC";

        $result2 = $conn->query($query2);
        $new_reg_ids = [];
        while ($row = $result2->fetch_assoc()) {
            $new_reg_ids[] = $row['new_student_registration_id'];
        }
        $matched_new_id = $new_reg_ids[0] ?? null;
    }

    // Default fallback if arrays empty
    if (empty($reg_ids)) {
        $reg_ids[] = null;
    }
    if (empty($new_reg_ids)) {
        $new_reg_ids = []; // keep empty, no fallback
    }

    $response['last_entered_id'] = $reg_ids[0] ?? null;
    $response['last_new_entered_id'] = $matched_new_id; // null if none found

    $response['student_reg_ids'] = array_reverse($reg_ids);
    $response['new_student_reg_ids'] = array_reverse($new_reg_ids);
    $response['success'] = true;
}

echo json_encode($response);
