        $stmt->bind_param('ss', $from_ts, $to_ts);
        $stmt->execute();
        $res = $stmt->get_result();
        while ($r = $res->fetch_assoc())
            $rows[] = $r;
        $headers = ['Staff', 'Orders', 'Total Sales', 'Avg Order'];
        $stmt->close();
        break;

    case 'free_items':
        $sql = "
            SELECT p.id AS product_id, p.name, COUNT(oi.id) AS free_count, SUM(oi.qty) AS qty_total
