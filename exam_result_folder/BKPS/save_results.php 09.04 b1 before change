function calculateFinalResult($studentId, $moduleId, $conn)
{
    $query = "SELECT 
                converted_marks, converted_marks_grade,
                ecm_r1_converted_marks, ecm_r1_converted_marks_grade,
                ecm_r2_converted_marks, ecm_r2_converted_marks_grade,
                ecm_r3_converted_marks, ecm_r3_converted_marks_grade,
                ecm_r4_converted_marks, ecm_r4_converted_marks_grade
              FROM student_results 
              WHERE student_id = ? AND module_id = ?";
    $stmt = $conn->prepare($query);
    $stmt->bind_param("ii", $studentId, $moduleId);
    $stmt->execute();
    $result = $stmt->get_result();

    $grades = [];
    $marks = [];

    while ($row = $result->fetch_assoc()) {


        if (!empty($row['ecm_r4_converted_marks_grade'])) {
            $grades[] = $row['ecm_r4_converted_marks_grade'];
            $marks[] = $row['ecm_r4_converted_marks'];
        } elseif (!empty($row['ecm_r3_converted_marks_grade'])) {
            $grades[] = $row['ecm_r3_converted_marks_grade'];
            $marks[] = $row['ecm_r3_converted_marks'];
        } elseif (!empty($row['ecm_r2_converted_marks_grade'])) {
            $grades[] = $row['ecm_r2_converted_marks_grade'];
            $marks[] = $row['ecm_r2_converted_marks'];
        } elseif (!empty($row['ecm_r1_converted_marks_grade'])) {
            $grades[] = $row['ecm_r1_converted_marks_grade'];
            $marks[] = $row['ecm_r1_converted_marks'];
        } elseif (!empty($row['converted_marks_grade'])) {
            $grades[] = $row['converted_marks_grade'];
            $marks[] = $row['converted_marks'];
        }
    }

    if (empty($grades)) {
        return null; // no results found
    }

    // Define groups
    $passGrades = ['Distinction', 'Merit', 'Pass'];
    $specialGrades = ['Resit', 'Not Submitted', 'Absent'];

    $uniqueGrades = array_unique($grades);

    // Rule: All Resit
    if (count($uniqueGrades) === 1 && $uniqueGrades[0] === 'Resit') {
        return 'Resit';
    }

    // Rule: All Not Submitted
    if (count($uniqueGrades) === 1 && $uniqueGrades[0] === 'Not Submitted') {
        return 'Resit';
    }

    // Rule: All Absent
    if (count($uniqueGrades) === 1 && $uniqueGrades[0] === 'Absent') {
        return 'Absent';
    }

    // Rule: Absent + Not Submitted (only these two types present)
    if (count($uniqueGrades) === 2 && in_array('Absent', $uniqueGrades) && in_array('Not Submitted', $uniqueGrades)) {
        return 'Absent';
    }

    // ✅ New Rule: Not Submitted + Resit
    if (count($uniqueGrades) === 2 && in_array('Not Submitted', $uniqueGrades) && in_array('Resit', $uniqueGrades)) {
        return 'Resit';
    }

    // Rule: Any special grade + any pass grade → Pending
    if (
        count(array_intersect($specialGrades, $uniqueGrades)) > 0 &&
        count(array_intersect($passGrades, $uniqueGrades)) > 0
    ) {
        return 'Pending';
    }

    // Rule: All passes → sum marks
    if (count(array_diff($uniqueGrades, $passGrades)) === 0) {
        return array_sum($marks);
    }

    // Default case
    return 'Pending';
}




// HD 
function calculateFinalResultHD($studentId, $moduleId, $conn)
{
    $query = "SELECT hd_converted_marks, hd_resit1_converted_marks, hd_resit2_converted_marks, hd_resit3_converted_marks FROM student_results WHERE student_id = ? AND module_id = ?";
    $stmt = $conn->prepare($query);
    $stmt->bind_param("ii", $studentId, $moduleId);
    $stmt->execute();
    $result = $stmt->get_result();

    $totalMarks = 0;
    while ($row = $result->fetch_assoc()) {
        // Check for hd_resit3_converted_marks first
        if ($row['hd_resit3_converted_marks'] > 0) {
            $totalMarks += $row['hd_resit3_converted_marks'];
        } elseif ($row['hd_resit2_converted_marks'] > 0) {
            $totalMarks += $row['hd_resit2_converted_marks'];
        } elseif ($row['hd_resit1_converted_marks'] > 0) {
            $totalMarks += $row['hd_resit1_converted_marks'];
        } else {
            $totalMarks += $row['hd_converted_marks'];
        }
    }
    return $totalMarks;
}


function getCompletionStatus($hdGrades)
{
    foreach ($hdGrades as $grade) {
        if (strtolower(trim($grade ?? '')) === 'not completed') {
            return 'Not Completed';
        }
    }
    return 'Completed';
}
