<script>
    const currentPassword = document.getElementById('currentPassword');
    const newPassword = document.getElementById('newPassword');
    const confirmPassword = document.getElementById('confirmPassword');
    const statusMessage = document.getElementById('statusMessage');
    const updateBtn = document.getElementById('updateBtn');
    const cancelBtn = document.getElementById('cancelBtn');

    // Requirements elements
    const reqLength = document.getElementById('req-length');
    const reqMatch = document.getElementById('req-match');

    function togglePasswordVisibility(inputId) {
        const input = document.getElementById(inputId);
        const eyeIcon = document.getElementById(`eye-icon-${inputId}`);
        if (input.type === "password") {
            input.type = "text";
            eyeIcon.textContent = "visibility_off";
        } else {
            input.type = "password";
            eyeIcon.textContent = "visibility";
        }
    }

    function updateRequirement(element, isValid) {
        const icon = element.querySelector('.material-symbols-outlined');
        if (isValid) {
            element.classList.remove('text-slate-500');
            element.classList.add('text-green-600', 'font-medium');
            icon.textContent = 'check_circle';
            icon.classList.remove('text-slate-300');
            icon.classList.add('text-green-500');
        } else {
            element.classList.add('text-slate-500');
            element.classList.remove('text-green-600', 'font-medium');
            icon.textContent = 'circle';
            icon.classList.add('text-slate-300');
            icon.classList.remove('text-green-500');
        }
    }

    function validatePasswords() {
        const newPass = newPassword.value;
        const confirmPass = confirmPassword.value;

        // Length requirement
        const isLengthValid = newPass.length >= 8;
        updateRequirement(reqLength, isLengthValid);

        // Match requirement
        const isMatchValid = newPass && confirmPass && newPass === confirmPass;
        updateRequirement(reqMatch, isMatchValid);

        if (newPass && confirmPass) {
            if (isMatchValid) {
                statusMessage.textContent = 'Passwords match correctly';
                statusMessage.className = 'mt-4 text-xs font-bold text-green-600';
                statusMessage.style.display = 'block';
                return isLengthValid;
            } else {
                statusMessage.textContent = 'Passwords do not match';
                statusMessage.className = 'mt-4 text-xs font-bold text-red-500';
                statusMessage.style.display = 'block';
                return false;
            }
        } else {
            statusMessage.style.display = 'none';
            return false;
        }
    }

    function updateButtonState() {
        const isValid = currentPassword.value &&
            newPassword.value &&
            confirmPassword.value &&
            validatePasswords();
        updateBtn.disabled = !isValid;
    }

    // Event listeners
    newPassword.addEventListener('input', () => {
        validatePasswords();
        updateButtonState();
    });

    confirmPassword.addEventListener('input', () => {
        validatePasswords();
        updateButtonState();
    });

    currentPassword.addEventListener('input', updateButtonState);

    cancelBtn.addEventListener('click', function() {
        currentPassword.value = '';
        newPassword.value = '';
        confirmPassword.value = '';
        statusMessage.style.display = 'none';
        updateRequirement(reqLength, false);
        updateRequirement(reqMatch, false);
        updateButtonState();
    });
</script>

