<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('studentForm');
        if (!form) return;

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const radioGroups = [
                'presentation', 'preparation', 'syllabus_coverage',
                'knowledge_subject', 'question_discussion',
                'interaction_students', 'punctuality', 'overall'
            ];

            let missingField = '';
            const allSelected = radioGroups.every(group => {
                if (!document.querySelector(`input[name="${group}"]:checked`)) {
                    missingField = group.replace(/_/g, ' ');
                    return false;
                }
                return true;
            });

            if (!allSelected) {
                alert(`Please provide a rating for: ${missingField.charAt(0).toUpperCase() + missingField.slice(1)}`);
                // Scroll to the missing field
                const target = document.querySelector(`input[name="${missingField.replace(/ /g, '_')}"]`).closest('.question-card');
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
                return;
            }

            const comments = document.getElementById('comments');
            if (!comments.value.trim()) {
                alert('Please enter your comments.');
                comments.focus();
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            const btnSpan = submitBtn.querySelector('span');
            const btnIcon = submitBtn.querySelector('i');

            const originalText = btnSpan.innerText;
            const originalIconClass = btnIcon.className;

            // Immediate Loading State
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.8';
            submitBtn.style.cursor = 'not-allowed';
            btnSpan.innerText = 'Submitting...';
            btnIcon.className = 'fas fa-spinner fa-spin';

            const formData = new FormData(form);

            fetch('insert_student.php', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server Error (${response.status}): ${text}`);
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        alert(data.message || 'Feedback submitted successfully!');
                        form.reset();
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        alert(data.message || 'Error occurred. Please try again.');
                        resetBtn();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(`Submission failed: ${error.message}`);
                    resetBtn();
                });

            function resetBtn() {
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
                submitBtn.style.cursor = 'pointer';
                btnSpan.innerText = originalText;
                btnIcon.className = originalIconClass;
            }
        });
    });
</script>

