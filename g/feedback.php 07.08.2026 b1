// ✅ Combined Optimized Query
$stmt = $conn->prepare("
    SELECT fl.*, 
           pt.program_name, 
           bt.batch_name, 
           m.module_name, 
           lt.lecturer_name 
    FROM feedback_links fl
    LEFT JOIN program_table pt ON fl.programme_id = pt.program_code
    LEFT JOIN batch_table bt ON fl.batch_id = bt.id
    LEFT JOIN modules m ON fl.module_id = m.id
    LEFT JOIN lecturer_table lt ON fl.lecturer_id = lt.id
    WHERE fl.link_id = ?
");
$stmt->bind_param("s", $feedback_id);
$stmt->execute();
$result = $stmt->get_result();
$feedback_details = $result->fetch_assoc();
$stmt->close();

